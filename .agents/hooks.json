{
  "git-safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/git_safety.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "python-auto-formatter": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/auto_format.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
